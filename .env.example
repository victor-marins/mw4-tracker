# Copie para .env.local e preencha. Nunca commite o .env.local.

# Opcional: avisos de desbloqueio num canal do Discord
DISCORD_WEBHOOK_URL=

# Vazio em dev = armazenamento em memória (some ao reiniciar). Em produção é obrigatório.
REDIS_URL=

# Só em dev, com armazenamento em memória (ignorado em produção e com REDIS_URL):
#   prod = copia os dados de produção pela API pública; o que você marcar local não vai para produção
#   fake = gera 30 dias de progresso fictício
DEV_SEED=prod
# DEV_PROD_URL=https://mw4-tracker.vercel.app
